From 75583f5ad80b744c0fbf4883b55c898614fa0db3 Mon Sep 17 00:00:00 2001
From: Tendai Makumire <tendai.makumire@imd-tec.com>
Date: Fri, 29 May 2026 12:38:31 +0100
Subject: [PATCH] Enable displayport via USB-C altmode driver

---
 display/kalama-imdt-sde-display-hdk.dtsi | 45 +++++++++++++++++-------
 1 file changed, 33 insertions(+), 12 deletions(-)

diff --git a/display/kalama-imdt-sde-display-hdk.dtsi b/display/kalama-imdt-sde-display-hdk.dtsi
index 8a66593..d748738 100755
--- a/display/kalama-imdt-sde-display-hdk.dtsi
+++ b/display/kalama-imdt-sde-display-hdk.dtsi
@@ -37,17 +37,38 @@
 	status = "disabled";
 };
 
-/* 	IMDT NOTE: 	
-	We must remove the connectors/components we are
-	are not using from the list. In our case,
-	we are currently not using DSI1 and the Display Port.
-	So &sde_dsi1 (DSI1) and &sde_dp (Display Port) have not 
-	be included in our list of connectors.
-
-	The display kernel drivers works similarly to the camera
-	kernel drivers where they use the Component Helper
-	subsystem to wait for multiple subdevices to be probed.
-*/
+&sde_dp {
+	status = "okay";
+
+	mode-switch;
+	svid = /bits/ 16 <0xFF01>;
+
+	port {
+		dp_altmode_ep: endpoint {
+			remote-endpoint = <&typec_connector_port1_ep>;
+		};
+	};
+};
+
+&typec_connector_ports {
+	port@1 {
+		reg = <1>;
+		typec_connector_port1_ep: endpoint {
+			remote-endpoint = <&dp_altmode_ep>;
+		};
+	};
+};
+
+/*
+ * We must remove the connectors/components we are
+ * are not using from the list. In our case,
+ * we are currently not using DSI1.
+ * So sde_dsi1 (DSI1) has been removed from our list of connectors.
+ *
+ * The display kernel drivers works similarly to the camera
+ * kernel drivers where they use the Component Helper
+ * subsystem to wait for multiple subdevices to be probed.
+ */
 &mdss_mdp {
-	connectors = <&sde_dsi &smmu_sde_unsec &sde_rscc &sde_wb1>;
+	connectors = <&sde_dsi &smmu_sde_unsec &sde_rscc &sde_wb1 &sde_dp>;
 };
-- 
