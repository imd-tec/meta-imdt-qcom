From ca779c8462ee3a3e15e443b795c01df1bdea7ab1 Mon Sep 17 00:00:00 2001
From: Tendai Makumire <tendai.makumire@imd-tec.com>
Date: Fri, 21 Aug 2026 15:26:45 +0100
Subject: [PATCH] Remove unnecessary display power supply nodes and entries

---
 display/kalama-imdt-sde-display-common.dtsi | 52 +--------------------
 display/kalama-imdt-sde-display-hdk.dtsi    |  2 +-
 2 files changed, 2 insertions(+), 52 deletions(-)

diff --git a/display/kalama-imdt-sde-display-common.dtsi b/display/kalama-imdt-sde-display-common.dtsi
index 9ec5bd3..1e5a1b9 100755
--- a/display/kalama-imdt-sde-display-common.dtsi
+++ b/display/kalama-imdt-sde-display-common.dtsi
@@ -3,22 +3,7 @@
 #include "kalama-imdt-sde-display-pinctrl.dtsi"
 
 &soc {
-	dsi_panel_pwr_supply_sim: dsi_panel_pwr_supply_sim {
-		#address-cells = <1>;
-		#size-cells = <0>;
-
-		qcom,panel-supply-entry@0 {
-			reg = <0>;
-			qcom,supply-name = "dummy";
-			qcom,supply-min-voltage = <1800000>;
-			qcom,supply-max-voltage = <1800000>;
-			qcom,supply-enable-load = <200000>;
-			qcom,supply-disable-load = <80>;
-			qcom,supply-post-on-sleep = <20>;
-		};
-	};
-
-	dsi_panel_pwr_supply: dsi_panel_pwr_supply {
+	dsi_panel_pwr_supply_vdd: dsi_panel_pwr_supply_vdd {
 		#address-cells = <1>;
 		#size-cells = <0>;
 
@@ -35,41 +20,6 @@
 		qcom,panel-supply-entry@1 {
 			reg = <1>;
 			qcom,supply-name = "vdd";
-			qcom,supply-min-voltage = <1200000>;
-			qcom,supply-max-voltage = <1200000>;
-			qcom,supply-enable-load = <299000>;
-			qcom,supply-disable-load = <0>;
-			qcom,supply-post-on-sleep = <0>;
-		};
-
-		qcom,panel-supply-entry@2 {
-			reg = <2>;
-			qcom,supply-name = "vci";
-			qcom,supply-min-voltage = <3000000>;
-			qcom,supply-max-voltage = <3000000>;
-			qcom,supply-enable-load = <10000>;
-			qcom,supply-disable-load = <0>;
-			qcom,supply-post-on-sleep = <0>;
-		};
-	};
-
-	dsi_panel_pwr_supply_avdd: dsi_panel_pwr_supply_avdd {
-		#address-cells = <1>;
-		#size-cells = <0>;
-
-		qcom,panel-supply-entry@0 {
-			reg = <0>;
-			qcom,supply-name = "vddio";
-			qcom,supply-min-voltage = <1800000>;
-			qcom,supply-max-voltage = <1800000>;
-			qcom,supply-enable-load = <200000>;
-			qcom,supply-disable-load = <80>;
-			qcom,supply-post-on-sleep = <20>;
-		};
-
-		qcom,panel-supply-entry@1 {
-			reg = <1>;
-			qcom,supply-name = "avdd";
 			qcom,supply-min-voltage = <3300000>;
 			qcom,supply-max-voltage = <3300000>;
 			qcom,supply-enable-load = <100000>;
diff --git a/display/kalama-imdt-sde-display-hdk.dtsi b/display/kalama-imdt-sde-display-hdk.dtsi
index 89d2f4a..8a66593 100755
--- a/display/kalama-imdt-sde-display-hdk.dtsi
+++ b/display/kalama-imdt-sde-display-hdk.dtsi
@@ -4,7 +4,7 @@
 	qcom,dsi-select-clocks = "pll_byte_clk0", "pll_dsi_clk0";
 	qcom,dsi-select-sec-clocks = "pll_byte_clk1", "pll_dsi_clk1";
 
-	qcom,panel-supply-entries = <&dsi_panel_pwr_supply_avdd>;
+	qcom,panel-supply-entries = <&dsi_panel_pwr_supply_vdd>;
 	qcom,mdss-dsi-bl-pmic-control-type = "bl_ctrl_pwm";
 	qcom,bl-pmic-pwm-period-usecs = <100>;
 	qcom,mdss-dsi-bl-min-level = <1>;
-- 
2.41.0

