@@ -0,0 +1,207 @@
+#include "kalama-imdt-sde.dtsi"
+#include "kalama-imdt-sde-display-common.dtsi"
+#include <dt-bindings/clock/qcom,dispcc-kalama.h>
+
+&pm8550_gpios {
+	display0_backlight_default: display0_backlight_default {
+		pins = "gpio6";
+		function = "normal";
+		input-disable;
+		output-enable;
+		bias-disable;
+		power-source = <1>;
+		qcom,drive-strength = <3>;
+	};
+};
+
+&soc {
+	sde_wb1: qcom,wb-display@1 {
+		compatible = "qcom,wb-display";
+		cell-index = <0>;
+		label = "wb_display1";
+	};
+	sde_wb2: qcom,wb-display@2 {
+		compatible = "qcom,wb-display";
+		cell-index = <1>;
+		label = "wb_display2";
+	};
+
+	disp_rdump_memory: disp_rdump_region@b8000000 {
+		reg = <0xb8000000 0x00800000>;
+		label = "disp_rdump_region";
+	};
+
+	display_panel_pwr_en: regulator-display-panel-en {
+		compatible = "regulator-fixed";
+		regulator-name = "display_panel_pwr_en";
+		regulator-min-microvolt = <8000000>;
+		regulator-max-microvolt = <8000000>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&disp_pwr_en_default>;
+		
+		gpio = <&tlmm 91 0>;
+		enable-active-high;
+		
+		vin-supply = <&som_vph_pwr>;
+
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+
+	// This is used as the VIN to the Backlight LED
+	// Driver.
+	dsi_5v_en: regulator-dsi-5v-en {
+		compatible = "regulator-fixed";
+		regulator-name = "dsi_5v_en";
+		regulator-min-microvolt = <8000000>;
+		regulator-max-microvolt = <8000000>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&dsi_5v_en_default>;
+		
+		gpio = <&tlmm 140 0>;
+		enable-active-high;
+		
+		vin-supply = <&som_vph_pwr>;
+
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	/* IMDT NOTE
+	 * Temporary Hack because DSI adapter is actually
+	 * using GPIO_123 (I2S1_WS) for 10_1PWR_EN.
+	 * This should be GPIO_91.
+	 */
+	display_panel_pwr_en_temp: regulator-display-panel-en-temp {
+		compatible = "regulator-fixed";
+		regulator-name = "display_panel_pwr_en_temp";
+		regulator-min-microvolt = <8000000>;
+		regulator-max-microvolt = <8000000>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&dsi_temp_disp_en_default>;
+		
+		gpio = <&tlmm 123 0>;
+		enable-active-high;
+		
+		vin-supply = <&som_vph_pwr>;
+
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	/* IMDT NOTE
+	 * Temporary Hack because DSI adapter is actually
+	 * using GPIO_121 (I2S1_SCK) for 10_Inch_Display_PWM.
+	 * This should be PM8550 GPIO6.
+	 * I don't think we can PWM this pin either!
+	 */
+	dsi_temp_bl_en: regulator-dsi-temp-bl-en {
+		compatible = "regulator-fixed";
+		regulator-name = "dsi_temp_bl_en";
+		regulator-min-microvolt = <8000000>;
+		regulator-max-microvolt = <8000000>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&dsi_temp_bl_en_default>;
+		
+		gpio = <&tlmm 121 0>;
+		enable-active-high;
+		
+		vin-supply = <&display_panel_pwr_en_temp>;
+
+		regulator-always-on;
+		regulator-boot-on;
+	};
+};
+
+&reserved_memory {
+	splash_memory: splash_region {
+		reg = <0x0 0xb8000000 0x0 0x02b00000>;
+		label = "cont_splash_region";
+	};
+
+	/*
+	 * Demura memory regions are to be commented out if
+	 * feature not in use.
+	 */
+	demura_memory_0: demura_region_0 {
+		reg = <0x0 0x0 0x0 0x0>;
+		label = "demura hfc region 0";
+	};
+
+	demura_memory_1: demura_region_1 {
+		reg = <0x0 0x0 0x0 0x0>;
+		label = "demura hfc region 1";
+	};
+};
+
+&sde_dsi {
+	clocks = <&mdss_dsi_phy0 0>,
+		 <&mdss_dsi_phy0 1>,
+		 <&mdss_dsi_phy1 2>,
+		 <&mdss_dsi_phy1 3>,
+		 /*
+		  * Currently the dsi clock handles are under the dsi
+		  * controller DT node. As soon as the controller probe
+		  * finishes, the dispcc sync state can get called before
+		  * the dsi_display probe potentially disturbing the clock
+		  * votes for cont_splash use case. Hence we are no longer
+		  * protected by the component model in this case against the
+		  * disp cc sync state getting triggered after the dsi_ctrl
+		  * probe. To protect against this incorrect sync state trigger
+		  * add this dummy MDP clk vote handle to the dsi_display
+		  * DT node. Since the dsi_display driver does not parse
+		  * MDP clock nodes, no actual vote shall be added and this
+		  * change is done just to satisfy sync state requirements.
+		  */
+		 <&dispcc DISP_CC_MDSS_MDP_CLK>;
+	clock-names = "pll_byte_clk0", "pll_dsi_clk0",
+		      "pll_byte_clk1", "pll_dsi_clk1",
+		      "mdp_core_clk";
+
+	/* IMDT Note - Changed these to use the power supplies on our board 1V8, 3V3 */
+	vddio-supply = <&per_1v8_reg>;
+	vdd-supply = <&per_3v3_reg>;
+};
+
+&sde_dsi1 {
+	clocks = <&mdss_dsi_phy0 0>,
+		 <&mdss_dsi_phy0 1>,
+		 <&mdss_dsi_phy1 2>,
+		 <&mdss_dsi_phy1 3>,
+		 /*
+		  * Currently the dsi clock handles are under the dsi
+		  * controller DT node. As soon as the controller probe
+		  * finishes, the dispcc sync state can get called before
+		  * the dsi_display probe potentially disturbing the clock
+		  * votes for cont_splash use case. Hence we are no longer
+		  * protected by the component model in this case against the
+		  * disp cc sync state getting triggered after the dsi_ctrl
+		  * probe. To protect against this incorrect sync state trigger
+		  * add this dummy MDP clk vote handle to the dsi_display
+		  * DT node. Since the dsi_display driver does not parse
+		  * MDP clock nodes, no actual vote shall be added and this
+		  * change is done just to satisfy sync state requirements.
+		  */
+		 <&dispcc DISP_CC_MDSS_MDP_CLK>;
+	clock-names = "pll_byte_clk0", "pll_dsi_clk0",
+		      "pll_byte_clk1", "pll_dsi_clk1",
+		      "mdp_core_clk";
+
+	/* IMDT Note - Changed these to use the power supplies on our board 1V8, 3V3 */
+	vddio-supply = <&per_1v8_reg>;
+	vdd-supply = <&per_3v3_reg>;
+
+};
+
+/* IMDT NOTE: 	
+ * This node is overrided in another dtsi file.
+ */
+&mdss_mdp {
+	connectors = <&sde_dsi &sde_dsi1 &smmu_sde_unsec &sde_wb1 &sde_wb2 &sde_rscc>;
+};
+
diff --git a/display/kalama-imdt-sde.dtsi b/display/kalama-imdt-sde.dtsi
