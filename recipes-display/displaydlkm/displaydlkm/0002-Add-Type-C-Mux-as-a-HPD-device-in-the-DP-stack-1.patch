--- a/msm/dp/dp_hpd.c
+++ b/msm/dp/dp_hpd.c
@@ -16,6 +16,7 @@
 #include "dp_lphw_hpd.h"
 #include "dp_debug.h"
 #include "dp_bridge_hpd.h"
+#include "dp_typec_mux.h"
 
 static void dp_hpd_host_init(struct dp_hpd *dp_hpd,
 		struct dp_catalog_hpd *catalog)
@@ -56,6 +57,12 @@ struct dp_hpd *dp_hpd_get(struct device *dev, struct dp_parser *parser,
 		}
 	}
 
+	dp_hpd = dp_typec_mux_get(dev, cb);
+	if (!IS_ERR_OR_NULL(dp_hpd)) {
+		dp_hpd->type = DP_HPD_TYPEC_MUX;
+		goto config;
+	}
+	
 	dp_hpd = dp_lphw_hpd_get(dev, parser, catalog, cb);
 	if (!IS_ERR_OR_NULL(dp_hpd)) {
 		dp_hpd->type = DP_HPD_LPHW;
@@ -116,6 +123,9 @@ void dp_hpd_put(struct dp_hpd *dp_hpd)
 	case DP_HPD_BRIDGE:
 		dp_bridge_hpd_put(dp_hpd);
 		break;
+	case DP_HPD_TYPEC_MUX:
+		dp_typec_mux_put(dp_hpd);
+		break;
 	default:
 		DP_ERR("unknown hpd type %d\n", dp_hpd->type);
 		break;
