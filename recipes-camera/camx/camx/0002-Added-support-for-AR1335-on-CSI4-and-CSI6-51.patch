+      <!--CSI Information -->
+      <CSIInfo description="CSI Information">
+          <laneAssign>0x3210</laneAssign>
+          <isComboMode>0</isComboMode>
+      </CSIInfo>
+      <!--Lens information -->
+      <lensInfo description="Lens Information">
