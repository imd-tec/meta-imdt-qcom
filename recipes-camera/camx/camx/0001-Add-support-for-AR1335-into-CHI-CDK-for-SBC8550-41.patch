+
+# User Variables
+set (SUPPORT_FUNCTION_CALL_TRACE 1)
+
+# NO DATA FOR SECTION: Custom additions (begin)
+
+# Get definitions common to the CAMX project here
+include (${CAMX_CHICDK_PATH}/core/build/linuxembedded/common.cmake)
+
+# Files and Build Type
+add_library(com.qti.sensor.ar1335 SHARED ../../ar1335_sensor.cpp)
+
+# Local Include Pathi
+include_directories (../..)
+
+# Include Paths
+include_directories (${CAMX_CHICDK_INCLUDES})
+
+# Dependencies
+
+# Libraries to compile
+target_link_libraries (com.qti.sensor.ar1335 dl)
+
+# Definitions
+add_definitions (${CAMX_CFLAGS})
+add_definitions (${CAMX_CPPFLAGS})
+# NO DATA FOR SECTION: Custom additions (end)
+
+# Auto-Gen
+#add_dependencies(com.qti.sensor.ar1335 autogen)
+
+install(TARGETS com.qti.sensor.ar1335 LIBRARY DESTINATION lib/camera)
+
+if (CONFIG STREQUAL "Debug")
+        add_definitions( -g )
+endif()
