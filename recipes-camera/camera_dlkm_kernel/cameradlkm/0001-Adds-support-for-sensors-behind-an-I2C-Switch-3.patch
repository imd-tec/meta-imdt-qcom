 }
 
 
+int32_t cam_cci_i2c_write_switch( struct camera_io_master *client)
+{
+	int rc, sid;
+	struct cam_sensor_i2c_reg_array reg_array;
+	struct cam_sensor_i2c_reg_setting i2c_switch_write_setting;
+	if (client == NULL || client->cci_client == NULL)
+		return -EINVAL;
+	reg_array.reg_addr = 1 << client->i2c_channel;
+	reg_array.reg_data = 1 << client->i2c_channel;
+	reg_array.delay = 0x00;
+	i2c_switch_write_setting.reg_setting = &reg_array;
+	i2c_switch_write_setting.size = 1;
+	i2c_switch_write_setting.addr_type = CAMERA_SENSOR_I2C_TYPE_BYTE;
+	i2c_switch_write_setting.data_type = CAMERA_SENSOR_I2C_TYPE_BYTE;
+	i2c_switch_write_setting.delay = 0;
+
+	sid = client->cci_client->sid;
+	client->cci_client->sid = client->i2c_switch;
+	rc = cam_cci_i2c_write_table_cmd(client, &i2c_switch_write_setting, MSM_CCI_I2C_WRITE);
+	client->cci_client->sid = sid;
+
+	return rc;
+}
+
