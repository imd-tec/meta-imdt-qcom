+#include <dt-bindings/msm-camera.h>
+
+&qupv3_2 {
+	compatible = "qcom,geni-se-qup", "simple-bus";
+};
+
+
+&soc {
+	qcom,cam-res-mgr {
+		compatible = "qcom,cam-res-mgr";
+		status = "ok";
+	};
+};
+
+&tlmm {
+	cam_sensor_mclk6_active: cam_sensor_mclk6_active {
+		/* MCLK6 */
+		mux {
+			pins = "gpio106";
+			function = "cam_mclk";
+		};
+
+		config {
+			pins = "gpio106";
+			bias-disable; /* No PULL */
+			drive-strength = <2>; /* 2 MA */
+		};
+	};
+
+	cam_sensor_mclk6_suspend: cam_sensor_mclk6_suspend {
+		/* MCLK6 */
+		mux {
+			pins = "gpio106";
+			function = "cam_mclk";
+		};
+
+		config {
+			pins = "gpio106";
+			bias-pull-down; /* PULL DOWN */
+			drive-strength = <2>; /* 2 MA */
+		};
+	};
+
+	cam_sensor_mclk7_active: cam_sensor_mclk7_active {
+		/* MCLK7 */
+		mux {
+			pins = "gpio107";
+			function = "cam_mclk";
+		};
+
+		config {
+			pins = "gpio107";
+			bias-disable; /* No PULL */
+			drive-strength = <2>; /* 2 MA */
+		};
+	};
+
+	cam_sensor_mclk7_suspend: cam_sensor_mclk7_suspend {
+		/* MCLK7 */
+		mux {
+			pins = "gpio107";
+			function = "cam_mclk";
+		};
+
+		config {
+			pins = "gpio107";
+			bias-pull-down; /* PULL DOWN */
+			drive-strength = <2>; /* 2 MA */
+		};
+	};
+
+	cam_sensor_active_rst6: cam_sensor_active_rst6 {
+		mux {
+			pins = "gpio71";
+			function = "gpio";
+		};
+
+		config {
+			pins = "gpio71";
+			bias-disable; /* No PULL */
+			drive-strength = <2>; /* 2 MA */
+		};
+	};
+
+	cam_sensor_suspend_rst6: cam_sensor_suspend_rst6 {
+		mux {
+			pins = "gpio71";
+			function = "gpio";
+		};
+
+		config {
+			pins = "gpio71";
+			bias-pull-down; /* PULL DOWN */
+			drive-strength = <2>; /* 2 MA */
+			output-low;
+		};
+	};
+
+	cam_sensor_active_rst7: cam_sensor_active_rst7 {
+		mux {
+			pins = "gpio109";
+			function = "gpio";
+		};
+
+		config {
+			pins = "gpio109";
+			bias-disable; /* No PULL */
+			drive-strength = <2>; /* 2 MA */
+		};
+	};
+
+	cam_sensor_suspend_rst7: cam_sensor_suspend_rst7 {
+		mux {
+			pins = "gpio109";
+			function = "gpio";
+		};
+
+		config {
+			pins = "gpio109";
+			bias-pull-down; /* PULL DOWN */
+			drive-strength = <2>; /* 2 MA */
+			output-low;
+		};
+	};
+};
+
+&cam_cci0 {
+	// ISP CCM1 - I2C0, CSI0, MCLK0, CAM0_RESET, SPI0
+	qcom,cam-sensor0 {
+		cell-index = <0>;
+		compatible = "qcom,cam-sensor";
+		csiphy-sd-index = <0>;
+
+		sensor-position-roll = <270>;
+		sensor-position-pitch = <0>;
+		sensor-position-yaw = <180>;
+
+		/* 
+		Power Supplies for CCM 
+		- 1V8_CAM (1.8V)
+		- 1V2 (1.2V)
+		- SNS_AVDD (2.8V)
+		*/
+		cam_vio-supply = <&cam_1v8_reg>;
+		cam_vdig-supply = <&cam_1v2_reg>;
+		cam_clk-supply = <&cam_cc_titan_top_gdsc>;
+		cam_vana-supply = <&cam_2v8_reg>;
+
+		regulator-names = "cam_vio", "cam_vdig","cam_clk", "cam_vana";
+		rgltr-cntrl-support;
+		rgltr-min-voltage = <1800000 1200000 0 2800000>;
+		rgltr-max-voltage = <1800000 1200000 0 2800000>;
+
+		// Vio Max - 0.12mA | Vdig Max - 162mA | Vanlog Max - 103mA
+		rgltr-load-current = <1000 180000 0 110000>;
+
+		gpio-no-mux = <0>;
+		// Look in kalama-camera.dtsi to find the pin number for I2C/MCLK
+		pinctrl-names = "cam_default", "cam_suspend";
+		pinctrl-0 = <&cam_sensor_mclk0_active &cam_sensor_active_rst0>;
+		pinctrl-1 = <&cam_sensor_mclk0_suspend &cam_sensor_suspend_rst0>;
+		gpios = <&tlmm 100 0>,<&tlmm 116 0>;
+		gpio-reset = <1>;
+		gpio-req-tbl-num = <0 1>;
+		gpio-req-tbl-flags = <1 0>;
+		gpio-req-tbl-label = "CAMIF_MCLK0","CAM_RESET0";
+
+		cci-master = <CCI_MASTER_0>;
+		clocks = <&camcc CAM_CC_MCLK0_CLK>;
+		clock-names = "cam_clk";
+		clock-cntl-level = "nominal";
+		clock-rates = <24000000>;
+		status = "ok";
+	};
+
