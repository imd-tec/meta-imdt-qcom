From ccfd20ca78c39567b4099fb2c04e79c33aeae268 Mon Sep 17 00:00:00 2001
From: Tendai Makumire <121951760+tmakumire@users.noreply.github.com>
Date: Thu, 27 Mar 2025 08:47:16 +0000
Subject: [PATCH] Added support for all 8 cameras in device tree (#18)

We should be able to access all 8 camera indexes
in CamX/CHI-CDK. We'll have to take into account
that CCM3 to CCM6 are all controlled via an I2C Mux
through AON_I2C controller. And we also have to note
that ISP CCM's are connected to an
external ISP (AP1302). So we are actually communicating
with the AP1302 and not with the sensor directly.
---
 kalama-camera-sensor-hdk.dts           |   2 +-
 kalama-camera-sensor-imdt-sbc8550.dtsi | 506 +++++++++++++++++++++++++
 2 files changed, 507 insertions(+), 1 deletion(-)
 create mode 100644 kalama-camera-sensor-imdt-sbc8550.dtsi

diff --git a/kalama-camera-sensor-hdk.dts b/kalama-camera-sensor-hdk.dts
index cc61bb8..3cfe40f 100755
--- a/kalama-camera-sensor-hdk.dts
+++ b/kalama-camera-sensor-hdk.dts
@@ -7,7 +7,7 @@
 #include <dt-bindings/interrupt-controller/arm-gic.h>
 #include <dt-bindings/regulator/qcom,rpmh-regulator-levels.h>
 
-#include "kalama-camera-sensor-hdk.dtsi"
+#include "kalama-camera-sensor-imdt-sbc8550.dtsi"
 / {
 	model = "Qualcomm Technologies, Inc. Kalama QRD";
 	compatible = "qcom,kalama-qrd", "qcom,kalama", "qcom,qrd";
diff --git a/kalama-camera-sensor-imdt-sbc8550.dtsi b/kalama-camera-sensor-imdt-sbc8550.dtsi
new file mode 100644
index 0000000..c15a03b
--- /dev/null
+++ b/kalama-camera-sensor-imdt-sbc8550.dtsi
