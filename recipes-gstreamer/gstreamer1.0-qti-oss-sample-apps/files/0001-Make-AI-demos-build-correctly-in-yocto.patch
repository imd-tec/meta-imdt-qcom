diff --git a/gst-sample-apps/gst-ai-parallel-inference/CMakeLists.txt b/gst-sample-apps/gst-ai-parallel-inference/CMakeLists.txt
index f532a40..3483d23 100644
--- a/gst-sample-apps/gst-ai-parallel-inference/CMakeLists.txt
+++ b/gst-sample-apps/gst-ai-parallel-inference/CMakeLists.txt
@@ -1,34 +1,34 @@
 cmake_minimum_required(VERSION 3.8.2)
 project(GST-AI-PARALLEL-INFERENCE LANGUAGES C CXX)
+project(gstreamer)
+include(GNUInstallDirs)
 
 set(CMAKE_INCLUDE_CURRENT_DIR ON)
-
-include_directories(${SYSROOT_INCDIR})
-link_directories(${SYSROOT_LIBDIR})
-link_directories(${GST_PLUGINS_QTI_OSS_INSTALL_LIBDIR})
-
-find_package(PkgConfig)
-
-# Get the pkgconfigs exported by the automake tools
-pkg_check_modules(GST
-  REQUIRED gstreamer-1.0>=${GST_VERSION_REQUIRED})
-
 set(GST_EXAMPLE_BIN gst-ai-parallel-inference)
-
-set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -Wall -Wextra -Werror")
+set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -Wall -Wextra -Werror -Wno-error=missing-field-initializers")
 set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -Wno-unused-parameter")
 
+find_package(PkgConfig REQUIRED)
+find_package(gstappsutils REQUIRED)
+
+pkg_check_modules(glib REQUIRED glib-2.0 IMPORTED_TARGET GLOBAL)
+pkg_check_modules(gstreamer REQUIRED gstreamer-1.0>=${GST_VERSION_REQUIRED} IMPORTED_TARGET GLOBAL)
+
 add_executable(${GST_EXAMPLE_BIN}
   main.c
 )
 
 target_include_directories(${GST_EXAMPLE_BIN} PRIVATE
   ${GST_INCLUDE_DIRS}
+  ${GLIB_INCLUDE_DIRS}
 )
 
 target_link_libraries(${GST_EXAMPLE_BIN} PRIVATE
   ${GST_LIBRARIES}
-  gstappsutils
+  ${GLIB_LIBRARIES}
+  gstappsutils::gstappsutils
+  PkgConfig::glib
+  PkgConfig::gstreamer
 )
 
 install(
