Subject: [PATCH] Make AI demos build correctly in yocto

Change-Id: Ib2de63c1e8991526d2fb8bd08c0fc5a352c79d46
---
 gst-sample-apps/CMakeLists.txt                | 28 +++++++++++++++++
 .../config_classification.json                |  2 +-
 ...g_daisychain_detection_classification.json |  4 +--
 .../gst-ai-monodepth/config_monodepth.json    |  2 +-
 .../config_detection.json                     |  2 +-
 .../gst-ai-parallel-inference/CMakeLists.txt  | 30 ++++++++++---------
 .../gst-ai-pose-detection/config_pose.json    |  2 +-
 .../config_segmentation.json                  |  2 +-
 8 files changed, 51 insertions(+), 21 deletions(-)
 create mode 100644 gst-sample-apps/CMakeLists.txt

diff --git a/gst-sample-apps/CMakeLists.txt b/gst-sample-apps/CMakeLists.txt
new file mode 100644
index 0000000..46022dc
--- /dev/null
+++ b/gst-sample-apps/CMakeLists.txt
@@ -0,0 +1,36 @@
+cmake_minimum_required(VERSION 3.8.2)
+project(GST_SAMPLE_APPS LANGUAGES C CXX)
+
+project(gstreamer)
+include(GNUInstallDirs)
+
+set(CMAKE_INCLUDE_CURRENT_DIR ON)
+set(GST_EXAMPLE_BIN gst-ai-parallel-inference)
+set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -Wall -Wextra -Werror -Wno-error=missing-field-initializers")
+set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -Wno-unused-parameter")
+
+find_package(PkgConfig REQUIRED)
+find_package(gstappsutils REQUIRED)
+
+pkg_check_modules(glib REQUIRED glib-2.0 IMPORTED_TARGET GLOBAL)
+pkg_check_modules(gstreamer REQUIRED gstreamer-1.0>=${GST_VERSION_REQUIRED} IMPORTED_TARGET GLOBAL)
+
+include_directories(${SYSROOT_INCDIR})
+link_directories(${SYSROOT_LIBDIR})
+
+add_subdirectory(gst-ai-classification)
+add_subdirectory(gst-ai-daisychain-detection-classification)
+add_subdirectory(gst-ai-daisychain-detection-pose)
+add_subdirectory(gst-ai-face-detection)
+add_subdirectory(gst-ai-face-recognition)
+add_subdirectory(gst-ai-monodepth)
+add_subdirectory(gst-ai-multi-input-output-object-detection)
+add_subdirectory(gst-ai-multistream-batch-inference)
+add_subdirectory(gst-ai-multistream-inference)
+add_subdirectory(gst-ai-object-detection)
+add_subdirectory(gst-ai-parallel-inference)
+add_subdirectory(gst-ai-pose-detection)
+add_subdirectory(gst-ai-segmentation)
+add_subdirectory(gst-ai-smartcodec-example)
+add_subdirectory(gst-ai-superresolution)
+
