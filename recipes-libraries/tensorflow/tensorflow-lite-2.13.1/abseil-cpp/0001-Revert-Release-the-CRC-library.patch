-  std::string extension = "Extension String";
-
-  EXPECT_EQ(
-      absl::ExtendCrc32c(absl::crc32c_t{base}, extension),
-      absl::crc32c_t{0xD2F65090});  // CRC32C of "Hello WorldExtension String"
-}
