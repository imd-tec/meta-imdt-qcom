diff --git a/tensorflow/lite/CMakeLists.txt b/tensorflow/lite/CMakeLists.txt
index 0476170e075..2bdc91fa37d 100644
--- a/tensorflow/lite/CMakeLists.txt
+++ b/tensorflow/lite/CMakeLists.txt
@@ -33,6 +33,21 @@ if(NOT CMAKE_BUILD_TYPE)
   set(CMAKE_BUILD_TYPE "Release")
 endif()
 
+#Compile time Flags
+if("${CMAKE_SYSTEM_NAME}" STREQUAL "Linux")
+  add_definitions(-DTFLITE_PROFILING_ENABLED)
+  add_definitions(-funsafe-math-optimizations)
+  add_definitions(-ftree-vectorize)
+  add_definitions(-flax-vector-conversions)
+  add_definitions(-fomit-frame-pointer)
+  add_definitions(-DBUILD_TESTING=OFF)
+  add_definitions(-DEIGEN_MPL2_ONLY)
+  add_definitions(-fPIC)
+  set(CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} -Wl,--no-undefined")
+  set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -fexceptions -fno-short-enums -Ofast")
+  set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wall -Wextra")
+endif()
+
 # Double colon in target name means ALIAS or IMPORTED target.
 cmake_policy(SET CMP0028 NEW)
 # Enable MACOSX_RPATH (@rpath) for built dynamic libraries.
@@ -69,6 +84,7 @@ cmake_dependent_option(TFLITE_ENABLE_NNAPI_VERBOSE_VALIDATION "Enable NNAPI verb
 option(TFLITE_ENABLE_MMAP "Enable MMAP (unsupported on Windows)" ON)
 option(TFLITE_ENABLE_GPU "Enable GPU" OFF)
 option(TFLITE_ENABLE_METAL "Enable Metal delegate (iOS only)" OFF)
+option(TFLITE_ENABLE_HEXAGON "Enable Hexagon" ON)
 option(TFLITE_ENABLE_XNNPACK "Enable XNNPACK backend" ON)
 option(TFLITE_ENABLE_EXTERNAL_DELEGATE "Enable External Delegate backend" ON)
 
@@ -88,7 +104,7 @@ if("${CMAKE_SYSTEM_NAME}" STREQUAL "Android")
   set(_TFLITE_ENABLE_RUY ON)
 endif()
 set(_TFLITE_ENABLE_NNAPI "${TFLITE_ENABLE_NNAPI}")
-if(NOT "${CMAKE_SYSTEM_NAME}" STREQUAL "Android")
+if(NOT ("${CMAKE_SYSTEM_NAME}" STREQUAL "Android" OR "${CMAKE_SYSTEM_NAME}" STREQUAL "Linux"))
   set(_TFLITE_ENABLE_NNAPI OFF)
 endif()
 set(_TFLITE_ENABLE_MMAP "${TFLITE_ENABLE_MMAP}")
@@ -148,6 +164,7 @@ find_package(gemmlowp REQUIRED)
 find_package(NEON_2_SSE REQUIRED)
 find_package(cpuinfo REQUIRED)  #CPUINFO is used by XNNPACK and RUY library
 find_package(ruy REQUIRED)
+find_package(nsync REQUIRED)
 # Download necessary dependencies.
 # Download pthreadpool source package if it doesn't exist.
 if(NOT DEFINED PTHREADPOOL_SOURCE_DIR)
@@ -263,6 +280,7 @@ populate_tflite_source_vars("core/tools" TFLITE_CORE_TOOLS_SRCS)
 populate_tflite_source_vars("c" TFLITE_C_SRCS)
 populate_tflite_source_vars("delegates" TFLITE_DELEGATES_SRCS)
 if(TFLITE_ENABLE_GPU)
+  add_definitions(-DTFLITE_ENABLE_GPU)
   find_package(opencl_headers REQUIRED)
   find_package(vulkan_headers REQUIRED)
   find_package(fp16_headers REQUIRED)
@@ -419,7 +437,9 @@ if(_TFLITE_ENABLE_NNAPI)
   populate_tflite_source_vars(
     "nnapi" TFLITE_NNAPI_SRCS FILTER "(_disabled)\\.(cc|h)$"
   )
-
+  populate_tflite_source_vars(
+    "nnapi/sl" TFLITE_NNAPI_SRCS FILTER "(_disabled)\\.(cc|h)$"
+  )
   list(APPEND TFLITE_NNAPI_SRCS
     "${TFLITE_SOURCE_DIR}/nnapi/sl/SupportLibrary.cc"
   )
@@ -445,13 +465,63 @@ if(TFLITE_ENABLE_XNNPACK)
   list(APPEND TFLITE_TARGET_DEPENDENCIES
     XNNPACK
   )
-  list(APPEND TFLITE_TARGET_PUBLIC_OPTIONS "-DTFLITE_BUILD_WITH_XNNPACK_DELEGATE")
 endif()
+
+if(TFLITE_ENABLE_HEXAGON)
+  add_definitions(-DTFLITE_ENABLE_HEXAGON)
+  populate_tflite_source_vars(
+    "delegates/hexagon"
+    TFLITE_DELEGATES_HEXAGON_SRCS
+    FILTER ".*(_test)\\.(cc|h)"
+  )
+  populate_tflite_source_vars(
+    "delegates/hexagon/builders"
+    TFLITE_DELEGATES_HEXAGON_BUILDERS_SRCS
+    FILTER ".*(_test)\\.(cc|h)"
+  )
+
+  list(APPEND TFLITE_DELEGATES_HEXAGON_SRCS
+    ${TFLITE_DELEGATES_HEXAGON_BUILDERS_SRCS}
+  )
+
+  #hexagon .so lib
+  populate_tflite_source_vars(
+    "delegates/hexagon/hexagon"
+    TFLITE_DELEGATES_HEXAGON_INT_SRCS
+    FILTER ".*(_test)\\.(cc|h)"
+  )
+
+  add_library(hexagon_interface SHARED
+    ${TFLITE_DELEGATES_HEXAGON_INT_SRCS}
+  )
+
+  target_link_libraries(hexagon_interface dl)
+
+  install(TARGETS hexagon_interface
+    LIBRARY
+  )
+else()
+  remove_definitions(-DTFLITE_ENABLE_HEXAGON)
+
+  set(TFLITE_DELEGATES_HEXAGON_SRCS
+    "${TFLITE_SOURCE_DIR}/delegates/hexagon/hexagon_delegate.cc"
+  )
+endif()
+
 if(TFLITE_ENABLE_EXTERNAL_DELEGATE)
   populate_tflite_source_vars("delegates/external"
     TFLITE_DELEGATES_EXTERNAL_SRCS
     FILTER ".*(_test|_tester)\\.(cc|h)"
   )
+list(APPEND TFLITE_DELEGATES_UTILS_SRCS
+  ${TFLITE_SOURCE_DIR}/delegates/utils/simple_delegate.h
+  ${TFLITE_SOURCE_DIR}/delegates/utils/simple_delegate.cc
+)
+
+add_library(utils_simple_delegate STATIC
+  ${TFLITE_DELEGATES_UTILS_SRCS}
+)
+
 endif()
 populate_tflite_source_vars("experimental/remat"
   TFLITE_EXPERIMENTAL_REMAT_SRCS
@@ -518,6 +588,16 @@ elseif(CMAKE_SYSTEM_NAME MATCHES "iOS")
   set_source_files_properties(${TFLITE_SOURCE_DIR}/profiling/signpost_profiler.mm PROPERTIES COMPILE_FLAGS -fno-objc-arc)
 endif()
 
+# Common include directories
+set(TFLITE_INCLUDE_DIRS
+  "${TENSORFLOW_SOURCE_DIR}"
+  "${TFLITE_FLATBUFFERS_SCHEMA_DIR}"
+)
+include_directories(
+  BEFORE
+    ${TFLITE_INCLUDE_DIRS}
+)
+
 # TFLite library
 set(_ALL_TFLITE_SRCS
   ${TFLITE_CORE_ACCELERATION_SRCS}
@@ -537,6 +617,7 @@ set(_ALL_TFLITE_SRCS
   ${TFLITE_DELEGATES_XNNPACK_SRCS}
   ${TFLITE_DELEGATES_EXTERNAL_SRCS}
   ${TFLITE_EXPERIMENTAL_REMAT_SRCS}
+  ${TFLITE_DELEGATES_HEXAGON_SRCS}
   ${TFLITE_EXPERIMENTAL_RESOURCE_SRCS}
   ${TFLITE_EXPERIMENTAL_RUY_PROFILER_SRCS}
   ${TFLITE_EXPERIMENTAL_RUY_SRCS}
@@ -565,6 +646,7 @@ list(FILTER _ALL_TFLITE_HDRS INCLUDE REGEX ".*\\.h$")
 target_include_directories(tensorflow-lite
   PUBLIC $<BUILD_INTERFACE:${TENSORFLOW_SOURCE_DIR}> $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
   ${CMAKE_BINARY_DIR}/gemmlowp
+  ${TFLITE_SOURCE_DIR}/delegates/hexagon/
 )
 target_link_libraries(tensorflow-lite
   PUBLIC
@@ -585,6 +667,8 @@ target_link_libraries(tensorflow-lite
     ${TFLITE_TARGET_DEPENDENCIES}
 )
 
+target_link_libraries(utils_simple_delegate tensorflow-lite)
+
 if (NOT BUILD_SHARED_LIBS)
   list(APPEND TFLITE_TARGET_PUBLIC_OPTIONS "-DTFL_STATIC_LIBRARY_BUILD")
 endif()
