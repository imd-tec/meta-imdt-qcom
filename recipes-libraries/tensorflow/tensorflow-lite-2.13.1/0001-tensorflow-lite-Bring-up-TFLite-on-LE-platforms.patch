+#include "remote.h"
+
+using remote_handle_open_fn = decltype(remote_handle_open);
+using remote_handle_invoke_fn = decltype(remote_handle_invoke);
+using remote_handle_close_fn = decltype(remote_handle_close);
+
+static void *g_handle = nullptr;
+
+static remote_handle_open_fn *g_remote_handle_open = nullptr;
+static remote_handle_invoke_fn *g_remote_handle_invoke = nullptr;
+static remote_handle_close_fn *g_remote_handle_close = nullptr;
+
+int remote_handle_open(const char* name, remote_handle *ph)
+{
+    if (nullptr == g_remote_handle_open) {
+        return -1;
+    }
+    return g_remote_handle_open(name, ph);
+}
+
+int remote_handle_invoke(remote_handle h, uint32_t dwScalars, remote_arg *pra)
+{
+    if (nullptr == g_remote_handle_invoke) {
+        return -1;
+    }
+    return g_remote_handle_invoke(h, dwScalars, pra);
+}
+
+int remote_handle_close(remote_handle h)
+{
+    if (nullptr == g_remote_handle_close) {
+        return -1;
+    }
+    return g_remote_handle_close(h);
+}
+
+static __attribute__((constructor)) void init(void)
+{
+    g_handle = dlopen("libcdsprpc.so", RTLD_LAZY);
+
+    if (nullptr != g_handle) {
