+&usb0 {
+	/* IMDT Workaround
+	 * The PM8550B PMIC can also act as an EUSB2 Repeater.
+	 * When it is being used as an EUSB2 Repeater (aswell as a PMIC),
+	 * it can detect VBUS events. And if we provide this EUD phandle
+	 * to extcon, it will route the VBUS events to our USB driver.
+	 *
+	 * On the IMDT SOM-8550, we don't have PM8550B PMIC.
+	 * And our EUSB2 Repeater does not do any VBUS detection.
+	 * So we must delete the property.
+	 */
+	/delete-property/ extcon;
+};
+
+&dwc3 {
+	/* IMDT Workaround
+	 * We currently disable role-switch as we haven't
+	 * properly set up VBUS detection. With the HDK,
+	 * the VBUS detection is done with PM8550B,
+	 * but we don't have this PMIC on our board.
+	 * So we'll have to investigate how we can
+	 * get VBUS detection with our current HW.
+	 * Our current HW has a GPIO which we can
+	 * read which tells us the state of VBUS.
+	 * We also need to make that role switching
+	 * works with our configuration of the TUSB321 IC.
+	 */
+	/delete-property/ usb-role-switch;
+};
