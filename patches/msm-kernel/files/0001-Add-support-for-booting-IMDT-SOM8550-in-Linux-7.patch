@@ -258,16 +259,21 @@ static int eusb2_repeater_init(struct usb_repeater *ur)
 	case NXP_REPEATER:
 		eusb2_i2c_read_reg(er, REVISION_ID, &reg_val);
 		break;
+	case IMDT_GPIO_REPEATER:
